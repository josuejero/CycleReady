{
  "name": "cycleready",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-static.js && node scripts/sync-reports.js && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:unit": "vitest run",
    "coverage": "vitest run --coverage",
    "qa:validate": "node scripts/validate-qa-data.mjs",
    "metrics": "node scripts/collect-metrics.mjs",
    "metrics:readme": "node scripts/update-readme-metrics.mjs",
    "evidence": "npm run qa:validate && npm run build && npm run test:e2e:ci && npm run metrics",
    "audit:lighthouse": "npm run build && lhci autorun",
    "docs:pdf": "PATH=\"$(python3 -c 'import site, os; print(os.path.join(site.USER_BASE, \"bin\"))'):$PATH\" pandoc docs/uat-plan.md -o public/assets/cycleready-uat-packet.pdf --pdf-engine=weasyprint"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.3.3",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.1.0",
    "@vitest/coverage-v8": "4.1.5",
    "autoprefixer": "^10.4.19",
    "csv-parse": "6.2.1",
    "jsdom": "29.1.1",
    "postcss": "^8.4.34",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.3.2",
    "vite": "^5.0.3",
    "vitest": "4.1.5"
  }
}
